{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.jinlize.tech/education/JLZ-EDU-AG-030/input.schema.json",
  "title": "课程顾问沟通质检输入契约",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "data_status",
    "contains_sensitive_data",
    "conversation_transcripts_redacted",
    "authorization_status",
    "course_and_price",
    "consultant_stage",
    "sales_policy",
    "prohibited_claims",
    "review_period"
  ],
  "properties": {
    "contract_version": {
      "const": "1.2.0"
    },
    "data_status": {
      "type": "string",
      "enum": [
        "confirmed",
        "partially_confirmed",
        "unconfirmed"
      ],
      "description": "输入资料的确认状态"
    },
    "contains_sensitive_data": {
      "type": "boolean"
    },
    "requested_output_language": {
      "type": "string",
      "enum": [
        "zh-CN",
        "en"
      ],
      "default": "zh-CN"
    },
    "conversation_transcripts_redacted": {
      "title": "脱敏沟通记录",
      "description": "仅授权范围内的真实通话或聊天转录",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "authorization_status": {
      "title": "录制与使用授权状态",
      "description": "未获授权不得处理",
      "type": "string",
      "minLength": 1
    },
    "course_and_price": {
      "title": "课程与价格",
      "description": "真实课程和收费口径",
      "type": "string",
      "minLength": 1
    },
    "consultant_stage": {
      "title": "沟通阶段",
      "description": "线索、试听、跟进或续费",
      "type": "string",
      "minLength": 1
    },
    "sales_policy": {
      "title": "销售规范",
      "description": "允许与禁止的表达",
      "type": "string",
      "minLength": 1
    },
    "prohibited_claims": {
      "title": "禁用承诺",
      "description": "保分、升学、名额等",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "review_period": {
      "title": "质检周期",
      "description": "抽样范围和日期",
      "type": "string",
      "minLength": 1
    },
    "resume_mode": {
      "type": "string",
      "enum": [
        "new",
        "resume",
        "target_change",
        "stage_rollback"
      ],
      "default": "new"
    },
    "agent_state": {
      "type": "object",
      "required": [
        "state_version",
        "product_id",
        "current_stage",
        "stage_status",
        "completed_stages",
        "confirmed_facts",
        "open_questions",
        "human_confirmation",
        "recovery_context",
        "change_log",
        "minimal_context"
      ],
      "properties": {
        "state_version": {
          "const": "1.2.0"
        },
        "product_id": {
          "const": "JLZ-EDU-AG-030"
        },
        "current_stage": {
          "type": "string",
          "enum": [
            "S1_SCOPE_CONFIRMATION",
            "S2_EVIDENCE_INVENTORY",
            "S3_PROFESSIONAL_DIAGNOSIS",
            "S4_SOLUTION_DESIGN",
            "S5_HUMAN_CONFIRMATION",
            "S6_FINAL_DELIVERY",
            "PAUSED",
            "FAILED"
          ]
        },
        "stage_status": {
          "type": "string",
          "enum": [
            "in_progress",
            "paused",
            "completed",
            "failed"
          ]
        },
        "completed_stages": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "S1_SCOPE_CONFIRMATION",
              "S2_EVIDENCE_INVENTORY",
              "S3_PROFESSIONAL_DIAGNOSIS",
              "S4_SOLUTION_DESIGN",
              "S5_HUMAN_CONFIRMATION",
              "S6_FINAL_DELIVERY"
            ]
          },
          "uniqueItems": true
        },
        "confirmed_facts": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "fact_id",
              "statement",
              "source_refs",
              "confirmed_by"
            ],
            "properties": {
              "fact_id": {
                "type": "string",
                "minLength": 1
              },
              "statement": {
                "type": "string",
                "minLength": 1
              },
              "source_refs": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "confirmed_by": {
                "type": "string",
                "minLength": 1
              },
              "confirmed_at": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        },
        "open_questions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "question_id",
              "question",
              "blocking",
              "owner"
            ],
            "properties": {
              "question_id": {
                "type": "string",
                "minLength": 1
              },
              "question": {
                "type": "string",
                "minLength": 1
              },
              "blocking": {
                "type": "boolean"
              },
              "owner": {
                "type": "string"
              },
              "needed_for": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        },
        "human_confirmation": {
          "type": "object",
          "required": [
            "required",
            "status"
          ],
          "properties": {
            "required": {
              "type": "boolean"
            },
            "status": {
              "type": "string",
              "enum": [
                "not_required",
                "pending",
                "confirmed",
                "rejected"
              ]
            },
            "review_scope": {
              "type": "string"
            },
            "confirmed_by": {
              "type": "string"
            },
            "confirmed_at": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "recovery_context": {
          "type": "object",
          "required": [
            "last_stable_stage",
            "resume_instruction",
            "affected_stages",
            "can_resume"
          ],
          "properties": {
            "last_stable_stage": {
              "type": "string",
              "enum": [
                "S1_SCOPE_CONFIRMATION",
                "S2_EVIDENCE_INVENTORY",
                "S3_PROFESSIONAL_DIAGNOSIS",
                "S4_SOLUTION_DESIGN",
                "S5_HUMAN_CONFIRMATION",
                "S6_FINAL_DELIVERY",
                "PAUSED",
                "FAILED"
              ]
            },
            "resume_instruction": {
              "type": "string",
              "minLength": 1
            },
            "affected_stages": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "S1_SCOPE_CONFIRMATION",
                  "S2_EVIDENCE_INVENTORY",
                  "S3_PROFESSIONAL_DIAGNOSIS",
                  "S4_SOLUTION_DESIGN",
                  "S5_HUMAN_CONFIRMATION",
                  "S6_FINAL_DELIVERY",
                  "PAUSED",
                  "FAILED"
                ]
              },
              "uniqueItems": true
            },
            "can_resume": {
              "type": "boolean"
            }
          },
          "additionalProperties": false
        },
        "change_log": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "event_type",
              "reason",
              "affected_stages",
              "occurred_at"
            ],
            "properties": {
              "event_type": {
                "type": "string",
                "enum": [
                  "resume",
                  "target_change",
                  "stage_rollback",
                  "interruption"
                ]
              },
              "reason": {
                "type": "string",
                "minLength": 1
              },
              "from_stage": {
                "type": "string",
                "enum": [
                  "S1_SCOPE_CONFIRMATION",
                  "S2_EVIDENCE_INVENTORY",
                  "S3_PROFESSIONAL_DIAGNOSIS",
                  "S4_SOLUTION_DESIGN",
                  "S5_HUMAN_CONFIRMATION",
                  "S6_FINAL_DELIVERY",
                  "PAUSED",
                  "FAILED"
                ]
              },
              "to_stage": {
                "type": "string",
                "enum": [
                  "S1_SCOPE_CONFIRMATION",
                  "S2_EVIDENCE_INVENTORY",
                  "S3_PROFESSIONAL_DIAGNOSIS",
                  "S4_SOLUTION_DESIGN",
                  "S5_HUMAN_CONFIRMATION",
                  "S6_FINAL_DELIVERY",
                  "PAUSED",
                  "FAILED"
                ]
              },
              "affected_stages": {
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": [
                    "S1_SCOPE_CONFIRMATION",
                    "S2_EVIDENCE_INVENTORY",
                    "S3_PROFESSIONAL_DIAGNOSIS",
                    "S4_SOLUTION_DESIGN",
                    "S5_HUMAN_CONFIRMATION",
                    "S6_FINAL_DELIVERY",
                    "PAUSED",
                    "FAILED"
                  ]
                },
                "uniqueItems": true
              },
              "occurred_at": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": false
          }
        },
        "minimal_context": {
          "type": "object",
          "required": [
            "user_goal",
            "scope"
          ],
          "properties": {
            "user_goal": {
              "type": "string",
              "minLength": 1
            },
            "scope": {
              "type": "string",
              "minLength": 1
            },
            "constraints": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "last_user_instruction": {
              "type": "string"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": {
        "required": [
          "resume_mode"
        ],
        "properties": {
          "resume_mode": {
            "enum": [
              "resume",
              "target_change",
              "stage_rollback"
            ]
          }
        }
      },
      "then": {
        "required": [
          "agent_state"
        ]
      }
    }
  ]
}
